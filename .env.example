# TranSFlator environment variables.
# Copy to `.env` (repo root) and edit, then:
#   docker compose -f docker/docker-compose.yml up -d --build
#
# Every variable is optional unless noted; sane defaults apply.

# --- Security (important) ---------------------------------------------
# Strong random secret used to encrypt stored API keys. Generate with:
#   openssl rand -hex 32
# If empty, an insecure dev default is used and a warning is logged.
APP_SECRET=

# Optional shared access token for the web UI + API. If set, all requests
# require `Authorization: Bearer <token>`. Empty = open access (dev only).
AUTH_TOKEN=

# --- Server -----------------------------------------------------------
# Host port the app is published on (container always listens on 8080).
PORT=8080
# tracing log level: error | warn | info | debug | trace
LOG_LEVEL=info

# --- Media library ----------------------------------------------------
# Host path to your media library, mounted read-only into the container at
# /media. Can be a directory containing videos/subfolders.
MEDIA_ROOT_HOST=./media

# --- Translation ------------------------------------------------------
# Max concurrent translation jobs.
CONCURRENCY=1
# Output filename pattern. Placeholders: {name} {lang} {ext}
OUTPUT_PATTERN={name}.{lang}.srt
# What to do if the output file already exists: overwrite | suffix | skip
OVERWRITE_BEHAVIOR=suffix
# Default target language for new jobs.
DEFAULT_TARGET_LANGUAGE=English
# Pinned llm-subtrans release tag (build arg).
LLM_SUBTRANS_VERSION=1.6.1
# Subprocess timeouts (seconds).
FFPROBE_TIMEOUT_SECS=30
FFMPEG_TIMEOUT_SECS=300

# --- Provider API keys (optional pre-seed) ----------------------------
# You can also set these later in the Settings UI (stored encrypted in the DB).
# Pre-seeding here is convenient for a fixed set of providers.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
